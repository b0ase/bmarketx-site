{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/str/:handle",
      "destination": "/api/page?kind=str&handle=:handle"
    },
    {
      "source": "/itm/:id",
      "destination": "/api/page?kind=itm&id=:id"
    },
    {
      "source": "/c/:cat",
      "destination": "/c"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bmarketx.com"
        }
      ],
      "destination": "https://bmarketx.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' capacitor://localhost https://localhost https://web.bwalletx.com https://desktop.bwalletx.com; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/.well-known/bwalletx-theme.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "{itm,str}.html"
    },
    "api/square.js": {
      "includeFiles": "brand/logo.svg"
    },
    "api/og.js": {
      "includeFiles": "{brand/og.svg,lib/fonts/*.ttf}"
    }
  }
}
