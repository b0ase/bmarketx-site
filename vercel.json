{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/str/:handle", "destination": "/str" },
    { "source": "/itm/:id", "destination": "/itm" }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.bmarketx.com" }], "destination": "https://bmarketx.com/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'self' capacitor://localhost https://localhost https://web.bwalletx.com https://desktop.bwalletx.com" }] },
    { "source": "/.well-known/bwalletx-theme.json", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
